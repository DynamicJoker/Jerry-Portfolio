---
import { siteContent } from '../content.js';

const { backHref = '#hero' } = Astro.props;
---

<footer class="c-footer">
  <div class="o-container">
    <div class="c-footer__content">
      <div class="c-footer__text">
        <p>
          &copy; <span id="footer-year">{new Date().getFullYear()}</span>
          {siteContent.profile.name}. {siteContent.ui.footer.rights}
        </p>
      </div>
      <div class="c-footer__links">
        {
          /* No RSS link here on purpose: browsers no longer render a feed, so
             clicking it just dumps raw XML at a visitor. The feed still exists
             and is still discoverable the way feed readers actually look for
             it — the <link rel="alternate" type="application/rss+xml"> in
             BaseLayout's head. */
        }
        <a href="/blog/" class="c-footer__link">{siteContent.ui.footer.blog}</a>
        <a
          href={siteContent.contactInfo.linkedin.url}
          class="c-footer__link"
          target="_blank"
          rel="noopener noreferrer">{siteContent.ui.footer.linkedin}</a
        >
        <a href={backHref} class="c-footer__link"
          >{siteContent.ui.footer.backToTop}</a
        >
      </div>
    </div>
  </div>
</footer>
