---
// Home page composition. Each section owns its own markup and the derivation
// it needs; this file just orders them. The blog section arrives through a
// slot because it needs the page's collection query.
import SiteFooter from './SiteFooter.astro';
import HeroSection from './sections/HeroSection.astro';
import AboutSection from './sections/AboutSection.astro';
import LogoBarSection from './sections/LogoBarSection.astro';
import SkillsSection from './sections/SkillsSection.astro';
import ServicesSection from './sections/ServicesSection.astro';
import TestimonialsSection from './sections/TestimonialsSection.astro';
import PortfolioSection from './sections/PortfolioSection.astro';
import ExperienceSection from './sections/ExperienceSection.astro';
import ContactSection from './sections/ContactSection.astro';
---

<main id="main-content">
  <HeroSection />

  <AboutSection />

  <LogoBarSection />

  <SkillsSection />

  <ServicesSection />

  <TestimonialsSection />

  <PortfolioSection />

  <ExperienceSection />

  <slot name="blog-section" />

  <ContactSection />
</main>

<SiteFooter />
